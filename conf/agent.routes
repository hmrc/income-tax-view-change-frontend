# agent specific routes
GET         /*path                                                        v1.controllers.agent.NewServiceAgentRedirectController.showAgent(path: String)

# Enter Clients UTR
GET         /client-utr                                                    v1.controllers.agent.EnterClientsUTRController.show()
POST        /client-utr                                                    v1.controllers.agent.EnterClientsUTRController.submit()
GET         /client-utr/:utr                                               v1.controllers.agent.EnterClientsUTRController.showWithUtr(utr: String)

# Confirm Client
GET         /confirm-client-details                                         v1.controllers.agent.ConfirmClientUTRController.show()
POST        /confirm-client-details                                         v1.controllers.agent.ConfirmClientUTRController.submit()

# UTR Error
GET         /cannot-view-client                                            v1.controllers.agent.UTRErrorController.show()
POST        /cannot-view-client                                            v1.controllers.agent.UTRErrorController.submit()

#Home Controller
GET         /remove-client-sessions                                        v1.controllers.agent.RemoveClientDetailsSessionsController.show()

