# microservice specific routes
->          /hmrc-frontend                                                hmrcfrontend.Routes

# Play frontend hmrc route for Assets
GET         /assets/*file                                                 controllers.Assets.versioned(path = "/public", file)

# Assets
GET         /assets/*file                                                 controllers.Assets.at(path="/public", file)

GET         /agents/*path                                                 v1.controllers.NewServiceRedirectController.showAgent(path: String)
GET         /*path                                                        v1.controllers.NewServiceRedirectController.show(path: String)

#Home Controller

GET         /                                                             v1.controllers.HomeController.show(origin: Option[String] ?= None)
GET         /income-tax                                                   v1.controllers.HomeController.show(origin: Option[String] ?= None)
GET         /agents/client-income-tax                                     v1.controllers.HomeController.showAgent()
GET         /agents                                                       v1.controllers.HomeController.showAgent()
GET         /your-tasks                                                   v1.controllers.newHomePage.HandleYourTasksController.show()
GET         /agents/your-tasks                                            v1.controllers.newHomePage.HandleYourTasksController.showAgent()


GET         /recent-activity                                              v1.controllers.newHomePage.RecentActivityController.show(isAgent: Boolean = false, origin: Option[String] ?= None)
GET         /agents/recent-activity                                       v1.controllers.newHomePage.RecentActivityController.show(isAgent: Boolean = true, origin: Option[String] ?= None)

GET         /overview                                                     v1.controllers.HomeController.handleOverview(origin: Option[String] ?= None, isAgent: Boolean = false)
GET         /help                                                         v1.controllers.HomeController.handleHelp(origin: Option[String] ?= None, isAgent: Boolean = false)
GET         /agents/overview                                              v1.controllers.HomeController.handleOverview(origin: Option[String] ?= None, isAgent: Boolean = true)
GET         /agents/help                                                  v1.controllers.HomeController.handleHelp(origin: Option[String] ?= None, isAgent: Boolean = true)

GET         /choose-tax-years-range                                       v1.controllers.ChooseTaxYearsRangeController.show()
POST        /choose-tax-years-range                                       v1.controllers.ChooseTaxYearsRangeController.submit()
GET         /choose-tax-years-range-sa                                    v1.controllers.ChooseTaxYearsRangeController.showPtaMultipleEnrolment()
POST        /choose-tax-years-range-sa                                    v1.controllers.ChooseTaxYearsRangeController.submitPtaMultipleEnrolment()



->          /                                                             common.Routes
