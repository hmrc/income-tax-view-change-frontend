# agent specific routes


# Enter Clients UTR
GET         /client-utr                                                    v2.controllers.agent.EnterClientsUTRController.show()
POST        /client-utr                                                    v2.controllers.agent.EnterClientsUTRController.submit()
GET         /client-utr/:utr                                               v2.controllers.agent.EnterClientsUTRController.showWithUtr(utr: String)

# Confirm Client
GET         /confirm-client-details                                         v2.controllers.agent.ConfirmClientUTRController.show()
POST        /confirm-client-details                                         v2.controllers.agent.ConfirmClientUTRController.submit()

# UTR Error
GET         /cannot-view-client                                            v2.controllers.agent.UTRErrorController.show()
POST        /cannot-view-client                                            v2.controllers.agent.UTRErrorController.submit()

#Home Controller
GET         /remove-client-sessions                                        v2.controllers.agent.RemoveClientDetailsSessionsController.show()

# Client Relationship Failure
GET         /not-authorised-to-view-client                                 v2.controllers.agent.ClientRelationshipFailureController.show()

GET         /no-assignment                                                 v2.controllers.agent.NoAssignmentController.show()

#Agent Error
GET         /agent-error                                                   v2.controllers.agent.errors.AgentErrorController.show()

GET        /language/:lang                                                 v2.controllers.agent.AgentLanguageController.switchToLanguage(lang: String)
