# NOTE: the two Assets routes below are redundant duplicates of the ones in conf/app.routes.
# They exist only so that this routes file's compilation unit also contributes the Assets
# reverse-route helper (controllers.routes.Assets) for templates - see Play's known limitation
# where two separate routes files declaring actions in the same controller package cause one
# file's reverse-route helper generation to clobber the other's (conf/app.routes's catch-all
# "/*path" route must stay ordered before these, so the authoritative forward-routing entries
# for /assets/*file remain in conf/app.routes; do not remove those).
GET         /assets/*file                                                 controllers.Assets.versioned(path = "/public", file)
GET         /assets/*file                                                 controllers.Assets.at(path="/public", file)

GET        /language/:lang                                                controllers.LocalLanguageController.switchToLanguage(lang: String)
GET        /agents/language/:lang                                         controllers.agent.AgentLanguageController.switchToLanguage(lang: String)

GET         /language/:lang                                               controllers.ItvcLanguageController.switchToLanguage(lang: String)
GET         /switch-to-welsh                                              controllers.ItvcLanguageController.switchToWelsh(fragment: Option[String])
GET         /switch-to-english                                            controllers.ItvcLanguageController.switchToEnglish(fragment: Option[String])

# Client Relationship Failure
GET         /agents/not-authorised-to-view-client                         controllers.agent.ClientRelationshipFailureController.show()

GET         /agents/no-assignment                                         controllers.agent.NoAssignmentController.show()

# No Income Sources Error page
GET         /no-income-sources                                              controllers.NoIncomeSourcesController.show(isAgent: Boolean = false)
GET         /agents/no-income-sources                                       controllers.NoIncomeSourcesController.show(isAgent: Boolean = true)

#Feedback Routes
GET         /feedback                                                     controllers.feedback.FeedbackController.show()
GET         /agents/feedback                                              controllers.feedback.FeedbackController.showAgent()
POST        /feedback                                                     controllers.feedback.FeedbackController.submit()
POST        /agents/feedback                                              controllers.feedback.FeedbackController.submitAgent()
GET         /thankyou                                                     controllers.feedback.FeedbackController.thankYou()
GET         /agents/thankyou                                              controllers.feedback.FeedbackController.thankYouAgent()

#Timeout Routes
GET         /session-timeout                                              controllers.timeout.SessionTimeoutController.timeout()
GET         /keep-alive                                                   controllers.timeout.SessionTimeoutController.keepAlive()

#Sign Out Routes
GET         /sign-out                                                     controllers.SignOutController.signOut()

#Sign In Routes
GET         /sign-in                                                      controllers.SignInController.signIn()

#Not Enrolled
GET         /cannot-access-service                                        controllers.errors.NotEnrolledController.show()

#Agent Error
GET         /agents/agent-error                                           controllers.agent.errors.AgentErrorController.show()

#Uplift Failed
GET         /cannot-view-page                                             controllers.errors.UpliftFailedController.show()

#Uplift Success
GET         /uplift-success                                               controllers.UpliftSuccessController.success()

