#Home Controller
GET         /                                                             v2.controllers.HomeController.show(origin: Option[String] ?= None)
GET         /income-tax                                                   v2.controllers.HomeController.show(origin: Option[String] ?= None)

GET         /choose-tax-years-range                                      v2.controllers.ChooseTaxYearsRangeController.show()
POST        /choose-tax-years-range                                      v2.controllers.ChooseTaxYearsRangeController.submit()
GET         /agents/client-income-tax                                     v2.controllers.HomeController.showAgent()
GET         /agents                                                       v2.controllers.HomeController.showAgent()
GET         /your-tasks                                                   v2.controllers.newHomePage.HandleYourTasksController.show()
GET         /agents/your-tasks                                            v2.controllers.newHomePage.HandleYourTasksController.showAgent()
GET         /choose-tax-years-range-sa                                   v2.controllers.ChooseTaxYearsRangeController.showPtaMultipleEnrolment()
POST        /choose-tax-years-range-sa                                   v2.controllers.ChooseTaxYearsRangeController.submitPtaMultipleEnrolment()

GET         /recent-activity                                              v2.controllers.newHomePage.RecentActivityController.show(isAgent: Boolean = false, origin: Option[String] ?= None)
GET         /agents/recent-activity                                       v2.controllers.newHomePage.RecentActivityController.show(isAgent: Boolean = true, origin: Option[String] ?= None)

GET         /overview                                                     v2.controllers.HomeController.handleOverview(origin: Option[String] ?= None, isAgent: Boolean = false)
GET         /help                                                         v2.controllers.HomeController.handleHelp(origin: Option[String] ?= None, isAgent: Boolean = false)
GET         /agents/overview                                              v2.controllers.HomeController.handleOverview(origin: Option[String] ?= None, isAgent: Boolean = true)
GET         /agents/help                                                  v2.controllers.HomeController.handleHelp(origin: Option[String] ?= None, isAgent: Boolean = true)

GET        /language/:lang                                                v2.controllers.LocalLanguageController.switchToLanguage(lang: String)

GET         /language/:lang                                               v2.controllers.ItvcLanguageController.switchToLanguage(lang: String)
GET         /switch-to-welsh                                              v2.controllers.ItvcLanguageController.switchToWelsh(fragment: Option[String])
GET         /switch-to-english                                            v2.controllers.ItvcLanguageController.switchToEnglish(fragment: Option[String])

# No Income Sources Error page
GET         /no-income-sources                                              v2.controllers.NoIncomeSourcesController.show(isAgent: Boolean = false)
GET         /agents/no-income-sources                                       v2.controllers.NoIncomeSourcesController.show(isAgent: Boolean = true)

#Feedback Routes
GET         /feedback                                                     v2.controllers.feedback.FeedbackController.show()
GET         /agents/feedback                                              v2.controllers.feedback.FeedbackController.showAgent()
POST        /feedback                                                     v2.controllers.feedback.FeedbackController.submit()
POST        /agents/feedback                                              v2.controllers.feedback.FeedbackController.submitAgent()
GET         /thankyou                                                     v2.controllers.feedback.FeedbackController.thankYou()
GET         /agents/thankyou                                              v2.controllers.feedback.FeedbackController.thankYouAgent()

#Timeout Routes
GET         /session-timeout                                              v2.controllers.timeout.SessionTimeoutController.timeout()
GET         /keep-alive                                                   v2.controllers.timeout.SessionTimeoutController.keepAlive()

#Sign Out Routes
GET         /sign-out                                                     v2.controllers.SignOutController.signOut()

#Sign In Routes
GET         /sign-in                                                      v2.controllers.SignInController.signIn()

#Not Enrolled
GET         /cannot-access-service                                        v2.controllers.errors.NotEnrolledController.show()

#Uplift Failed
GET         /cannot-view-page                                             v2.controllers.errors.UpliftFailedController.show()

#Uplift Success
GET         /uplift-success                                               v2.controllers.UpliftSuccessController.success()

